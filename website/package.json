{
  "name": "website",
  "private": true,
  "scripts": {
    "start": "tsc -b ../typescript/browser && docusaurus start",
    "build": "tsc -b ../typescript/browser && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "test": "yarn test:decode && yarn test:browser",
    "test:decode": "tsc -b ../typescript/browser && node --test --test-concurrency=1 --test-timeout=120000 test/decode.test.mjs",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=120000 test/browser.test.mjs"
  },
  "dependencies": {
    "@4dgs/browser": "workspace:^",
    "@4dgs/core": "workspace:^",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
