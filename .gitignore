# Generated conformance binaries — reconstructed deterministically before every run.
tests/conformance/data/*.4dgs

# Build and tooling output
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
node_modules/
target/
.pytest_cache/
.ruff_cache/
*.tsbuildinfo

# Swift Package Manager build output
.build/
.swiftpm/

# Yarn keeps its cache globally; only the lockfile belongs in the tree
.yarn/

# Generated documentation is never committed
__docs__/
site/
website/build/

# Rust build output
target/
Cargo.lock

# Sanitizer and other out-of-tree CMake build directories
build-*/
