{
  "name": "4dgs-workspace",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "typescript/*",
    "tests/conformance",
    "website"
  ],
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "5.6.3"
  },
  "resolutions": {
    "qs@npm:~6.15.1": "npm:6.16.0",
    "image-size@npm:^2.0.2": "patch:image-size@npm%3A2.0.2#~/.yarn/patches/image-size-npm-2.0.2-43abbcfb5c.patch"
  },
  "scripts": {
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "tsc -b && node --test typescript/conformance/dist/*.test.js",
    "conformance": "python3 tests/conformance/run.py --runner typescript",
    "fuzz": "tsc -b && node --test typescript/conformance/dist/fuzz.test.js",
    "browser": "tsc -b && node typescript/conformance/dist/browser_smoke.js"
  }
}
